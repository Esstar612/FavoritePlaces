rules_version = '2';

// Photos are uploaded to users/{uid}/photos/{uuid}.jpg
// (see mobile/lib/services/firestore_service.dart uploadPhoto).
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{userId}/photos/{photo} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
