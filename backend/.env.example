# ═══════════════════════════════════════════════════════════════
# FAVORITE PLACES BACKEND - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# Every variable below is one the server actually reads.

# ───────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# NODE_ENV=production

# ───────────────────────────────────────────────────────────────
# Firebase Admin SDK
# ───────────────────────────────────────────────────────────────
# Get this from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → Download JSON
#
# Local development: point at the downloaded file.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#
# Cloud Run / Heroku / any container: paste the entire JSON as one line instead.
# This takes precedence over FIREBASE_SERVICE_ACCOUNT_PATH when both are set.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# ───────────────────────────────────────────────────────────────
# Google Gemini API (powers all AI features)
# ───────────────────────────────────────────────────────────────
# Get a free key from: https://aistudio.google.com/app/apikey
# Required — every /ai/* endpoint fails without it.
GEMINI_API_KEY=your-gemini-api-key-here

# ───────────────────────────────────────────────────────────────
# Google Cloud Vision API (optional - for advanced image tagging)
# ───────────────────────────────────────────────────────────────
# If set, /ai/suggest-tags runs label/landmark detection before calling Gemini.
# Leave blank to skip Vision and use Gemini alone.
# GOOGLE_APPLICATION_CREDENTIALS=./google-cloud-key.json

# ───────────────────────────────────────────────────────────────
# CORS Configuration
# ───────────────────────────────────────────────────────────────
# Allowed origins (comma-separated for multiple).
# Prefer an explicit list over '*' — '*' lets any site call this API with a
# stolen ID token.
# Local dev:   http://localhost:8080,http://localhost:3000
# Production:  https://favorite-places-app-94adb.web.app
CORS_ORIGIN=https://favorite-places-app-94adb.web.app

# ───────────────────────────────────────────────────────────────
# Rate Limiting
# ───────────────────────────────────────────────────────────────
# Window length, and the per-IP cap for /ai/* routes within it.
# /user/* routes get 5x this cap (cheaper than a Gemini call, but still scan
# the caller's places collection).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
