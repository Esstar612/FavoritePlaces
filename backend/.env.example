# ═══════════════════════════════════════════════════════════════
# FAVORITE PLACES BACKEND - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# Every variable below is one the server actually reads.

# ───────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# NODE_ENV=production

# ───────────────────────────────────────────────────────────────
# Google Cloud (Firebase Admin and Gemini on Vertex AI)
# ───────────────────────────────────────────────────────────────
# No key files. Both use Application Default Credentials: locally, run
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project your-project-id
# On Cloud Run, the service's own service account is used.
# Required: the server exits on startup without it.
GOOGLE_CLOUD_PROJECT=your-project-id
# Vertex AI region for Gemini calls. Defaults to us-central1.
# GOOGLE_CLOUD_LOCATION=us-central1

# ───────────────────────────────────────────────────────────────
# Google Cloud Vision API (optional - for advanced image tagging)
# ───────────────────────────────────────────────────────────────
# If the Vision API is enabled on the project, /ai/suggest-tags runs
# label/landmark detection before calling Gemini. Otherwise Gemini works alone.

# ───────────────────────────────────────────────────────────────
# Google Maps (server-side only)
# ───────────────────────────────────────────────────────────────
# Used by GET /maps/reverse-geocode. Needs a key restricted to the Geocoding
# API. It lives here rather than in the app because the Geocoding web service
# rejects HTTP-referrer-restricted keys, so the web build cannot call it
# directly without shipping an unrestricted key.
GOOGLE_MAPS_SERVER_KEY=your-geocoding-key-here

# ───────────────────────────────────────────────────────────────
# CORS Configuration
# ───────────────────────────────────────────────────────────────
# Allowed origins (comma-separated for multiple).
# Prefer an explicit list over '*' — '*' lets any site call this API with a
# stolen ID token.
# Local dev:   http://localhost:8080,http://localhost:3000
# Production:  https://favorite-places-app-94adb.web.app
CORS_ORIGIN=https://favorite-places-app-94adb.web.app

# ───────────────────────────────────────────────────────────────
# Rate Limiting
# ───────────────────────────────────────────────────────────────
# Window length, and the per-IP cap for /ai/* routes within it.
# /user/* routes get 5x this cap (cheaper than a Gemini call, but still scan
# the caller's places collection).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
