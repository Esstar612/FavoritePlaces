ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=favorite-places-outing-agent

# Firebase credentials, first non-empty match wins:
# 1. FIREBASE_SERVICE_ACCOUNT_JSON  whole key JSON as one string
# 2. FIREBASE_SERVICE_ACCOUNT_PATH  key file; relative paths resolve against agent/
# 3. neither set: Application Default Credentials (Cloud Run's attached
#    service account, or `gcloud auth application-default login` locally)
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
GOOGLE_CLOUD_PROJECT=favorite-places-app-94adb
